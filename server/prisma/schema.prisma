generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public"]
}

model User {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  passwordHash  String    @map("password_hash")
  role          String    @default("PERITO") // ADMIN, PERITO, VISUALIZADOR
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  lastLoginAt   DateTime? @map("last_login_at")
  deletedAt     DateTime? @map("deleted_at")

  // Relations
  createdVestiges     Vestige[]               @relation("CreatedBy")
  updatedVestiges     Vestige[]               @relation("UpdatedBy")
  auditLogs           AuditLog[]
  sessions            Session[]
  destinationChanges  VestigeDestinationLog[]
  changedDestinations Vestige[]               @relation("DestinationChangedBy")
  passwordResetTokens PasswordResetToken[]
  pcnetActionLogs     PcnetActionLog[]
  withdrawalRequests      WithdrawalRequest[] @relation("WithdrawalRequestedBy")
  withdrawalStatusChanges WithdrawalRequest[] @relation("WithdrawalStatusChangedBy")

  @@map("users")
  @@schema("public")
}

model VestigeCategory {
  id            Int       @id @default(autoincrement())
  name          String    @unique
  originalSheet String?   @map("original_sheet")
  description   String?
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now()) @map("created_at")

  // Relations
  vestiges      Vestige[]

  @@map("vestige_categories")
  @@schema("public")
}

model Vestige {
  id            String    @id @default(uuid())
  legacyId      String?   @map("legacy_id")
  categoryId    Int       @map("category_id")
  registroFav   String?   @map("registro_fav")
  // Coluna congelada: desde 2026-09-10 a requisição fica em `vestige_requisicoes` (1:N).
  // Mantida só como cópia de segurança do backfill — nada no sistema lê ou grava aqui.
  // Remover em migration própria depois de conferir as contagens em produção.
  requisicaoLegado String? @map("requisicao")
  material      String
  tipoMaterial  String?   @map("tipo_material")
  municipio     String    @default("Lavras")
  dataColeta    DateTime? @map("data_coleta")
  observacoes   String?
  
  // Metadados
  createdBy     String?   @map("created_by")
  updatedBy     String?   @map("updated_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  // Estado de Conservação e Destinação
  estadoConservacao   String    @default("NAO_AVALIADO") @map("estado_conservacao")
  destinacao          String    @default("NAO_INICIADO")
  destinacaoObs       String?   @map("destinacao_obs")
  destinacaoChangedBy String?   @map("destinacao_changed_by")
  destinacaoChangedAt DateTime? @map("destinacao_changed_at")

  // Controle de importação
  importedFrom  String    @default("google_sheets") @map("imported_from")
  importedAt    DateTime? @map("imported_at")

  // Relations
  category           VestigeCategory         @relation(fields: [categoryId], references: [id])
  creator            User?                   @relation("CreatedBy", fields: [createdBy], references: [id])
  updater            User?                   @relation("UpdatedBy", fields: [updatedBy], references: [id])
  destinationLogs    VestigeDestinationLog[]
  destinationChanger User?                   @relation("DestinationChangedBy", fields: [destinacaoChangedBy], references: [id])
  involucros         VestigeInvolucro[]
  requisicoes        VestigeRequisicao[]
  pcnetActionLogs    PcnetActionLog[]
  withdrawalItems    WithdrawalRequestItem[]

  @@map("vestiges")
  @@schema("public")
}

// Invólucros e requisições guardam só número e motivo (regras em server/src/services/vestigeItemService.ts).
// O default LEGADO cobre o que já existia e o que os scripts de importação gravam.
// removedAt é remoção lógica: o item lançado por engano sai da tela, mas o registro fica no banco.
model VestigeInvolucro {
  id        BigInt    @id @default(autoincrement())
  vestigeId String    @map("vestige_id")
  numero    String
  motivo    String    @default("LEGADO")
  removedAt DateTime? @map("removed_at")
  createdAt DateTime  @default(now()) @map("created_at")

  // Relations
  vestige   Vestige   @relation(fields: [vestigeId], references: [id], onDelete: Cascade)

  @@index([vestigeId])
  @@index([numero])
  @@map("vestige_involucros")
  @@schema("public")
}

model VestigeRequisicao {
  id        BigInt    @id @default(autoincrement())
  vestigeId String    @map("vestige_id")
  numero    String
  motivo    String    @default("LEGADO")
  removedAt DateTime? @map("removed_at")
  createdAt DateTime  @default(now()) @map("created_at")

  // Relations
  vestige   Vestige   @relation(fields: [vestigeId], references: [id], onDelete: Cascade)

  @@index([vestigeId])
  @@index([numero])
  @@map("vestige_requisicoes")
  @@schema("public")
}

model VestigeDestinationLog {
  id          BigInt   @id @default(autoincrement())
  vestigeId   String   @map("vestige_id")
  fromStatus  String?  @map("from_status")
  toStatus    String   @map("to_status")
  observation String?
  changedBy   String   @map("changed_by")
  changedAt   DateTime @default(now()) @map("changed_at")

  // Relations
  vestige     Vestige  @relation(fields: [vestigeId], references: [id])
  user        User     @relation(fields: [changedBy], references: [id])

  @@map("vestige_destination_logs")
  @@schema("public")
}

model PcnetActionLog {
  id              BigInt   @id @default(autoincrement())
  vestigeId       String   @map("vestige_id")
  action          String   // VIEW_FAV, MOVIMENTAR
  status          String   @default("SOLICITADO") // SOLICITADO — o EvidenceOS só abre a tela do PCNET, não confirma se o usuário salvou algo lá
  pcnetIdentifier String   @map("pcnet_identifier") // registroFav usado na URL, para rastreabilidade
  requestedBy     String   @map("requested_by")
  requestedAt     DateTime @default(now()) @map("requested_at")

  // Relations
  vestige         Vestige  @relation(fields: [vestigeId], references: [id])
  user            User     @relation(fields: [requestedBy], references: [id])

  @@index([vestigeId])
  @@map("pcnet_action_logs")
  @@schema("public")
}

// Solicitação de retirada de vestígios (docs/plans/2026-08-25-solicitacao-retirada.md).
// Registra a INTENÇÃO: quem pediu, para quando e por quê. O ato oficial segue sendo a FAV do PCNET.
// Sem deletedAt: cancelar é status, não exclusão — registro de custódia não se apaga.
model WithdrawalRequest {
  id               String    @id @default(uuid())
  scheduledFor     DateTime  @map("scheduled_for")
  status           String    @default("SOLICITADA") // SOLICITADA, CONCLUIDA, CANCELADA, NAO_COMPARECEU
  notes            String?
  // Preenchido SÓ quando um ADMIN agenda com menos de 24h de antecedência. Nulo = dentro do prazo.
  // Coluna própria, e não dentro de `notes`, porque "quem furou o prazo e por quê" precisa ser consulta.
  deadlineOverrideReason String? @map("deadline_override_reason")
  requestedBy      String    @map("requested_by")
  requestedAt      DateTime  @default(now()) @map("requested_at")
  statusChangedBy  String?   @map("status_changed_by")
  statusChangedAt  DateTime? @map("status_changed_at")
  statusNote       String?   @map("status_note")

  // Relations
  requester        User      @relation("WithdrawalRequestedBy", fields: [requestedBy], references: [id])
  statusChanger    User?     @relation("WithdrawalStatusChangedBy", fields: [statusChangedBy], references: [id])
  items            WithdrawalRequestItem[]

  @@index([scheduledFor])
  @@index([status])
  @@map("withdrawal_requests")
  @@schema("public")
}

model WithdrawalRequestItem {
  // BigInt: nunca devolver este id cru em JSON — o Fastify responde 500 (converter com String()).
  id           BigInt  @id @default(autoincrement())
  requestId    String  @map("request_id")
  vestigeId    String  @map("vestige_id")
  reason       String  // CÓDIGO (DESTRUICAO, RESTITUICAO, ...), nunca o rótulo exibido
  reasonDetail String? @map("reason_detail")

  // Relations
  request      WithdrawalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  vestige      Vestige           @relation(fields: [vestigeId], references: [id])

  @@index([requestId])
  @@index([vestigeId])
  @@map("withdrawal_request_items")
  @@schema("public")
}

model CustodyStandard {
  id            Int       @id @default(autoincrement())
  code          String    @unique
  title         String
  category      String?   // legislação, norma_tecnica, procedimento_interno
  description   String?
  fullText      String?   @map("full_text")
  sourceUrl     String?   @map("source_url")
  effectiveDate DateTime? @map("effective_date")
  version       String?
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("custody_standards")
  @@schema("public")
}

model AuditLog {
  id            BigInt    @id @default(autoincrement())
  userId        String?   @map("user_id")
  userEmail     String    @map("user_email")
  userName      String    @map("user_name")
  action        String    // LOGIN, LOGOUT, SEARCH, etc.
  targetType    String?   @map("target_type")
  targetId      String?   @map("target_id")
  details       Json      @default("{}")
  ipAddress     String?   @map("ip_address")
  userAgent     String?   @map("user_agent")
  sessionId     String?   @map("session_id")
  createdAt     DateTime  @default(now()) @map("created_at")

  // Relations
  user          User?     @relation(fields: [userId], references: [id])

  @@map("audit_logs")
  @@schema("public")
}

model Session {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  tokenHash     String    @map("token_hash")
  ipAddress     String?   @map("ip_address")
  userAgent     String?   @map("user_agent")
  expiresAt     DateTime  @map("expires_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  revokedAt     DateTime? @map("revoked_at")

  // Relations
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
  @@schema("public")
}

model PasswordResetToken {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  tokenHash     String    @map("token_hash") // hash SHA-256 do token em texto claro
  expiresAt     DateTime  @map("expires_at")
  usedAt        DateTime? @map("used_at")    // uso único: preenchido ao ser consumido
  createdAt     DateTime  @default(now())    @map("created_at")
  createdByIp   String?   @map("created_by_ip")

  // Relations
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
  @@schema("public")
}
